{
	"name": "sushi-theme",
	"version": "1.0.0",
	"private": "true",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build:core":"cd ./packages/typing-fx/core && pnpm build",
		"build:physics-2d":"cd ./packages/typing-fx/physics-2d && pnpm build",
		"build:tracking":"cd ./packages/typing-fx/tracking && pnpm build",
		"load-fx:physics-2d": "pnpm --filter \"@typing-fx/physics-2d\" add \"@typing-fx/core@workspace:*\"",
		"load-fx:tracking":"pnpm --filter \"@typing-fx/tracking\" add \"@typing-fx/core@workspace:*\" \"@typing-fx/physics-2d@workspace:*\"",
		"load:core":"pnpm --filter \"sushitheme\" add \"@typing-fx/core@workspace:*\"",
		"load:physics-2d":"pnpm --filter \"sushitheme\" add \"@typing-fx/physics-2d@workspace:*\"",
		"load:tracking":"pnpm --filter \"sushitheme\" add \"@typing-fx/tracking@workspace:*\"",

		"load-fx":"pnpm load-fx:physics-2d && pnpm load-fx:tracking",
		"build:typing-fx":"pnpm build:core && pnpm build:physics-2d && pnpm build:tracking",
		"load:typing-fx":"pnpm load:core && pnpm load:physics-2d && pnpm load:tracking",
		"reset":"pnpm dlx rimraf --glob \"**/node_modules\" \"**/dist\" & pnpm store prune & pnpm cache delete && pnpm install",

		"bootstrap":"pnpm load-fx && pnpm build:typing-fx && pnpm load:typing-fx"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.33.2"
}
