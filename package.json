{
	"name": "sushitheme",
	"displayName": "SUSHI Theme",
	"description": "A delicious, dark theme inspired by Nori, Shari, and Wasabi.",
	"version": "1.0.1",
	"publisher": "ichimura-tomoo",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/tomopumipumi/SUSHI-Theme_ForVSCode"
	},
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"sushi-maguro": {
				"description": "Maguro sushi icon",
				"default": {
					"fontPath": "./assets/fonts/sushi-icons.woff",
					"fontCharacter": "\\f000"
				}
			},
			"sushi-fire": {
				"description": "Fire icon for sushi effects",
				"default": {
					"fontPath": "./assets/fonts/sushi-icons.woff",
					"fontCharacter": "\\f001"
				}
			}
		},
		"themes": [
			{
				"label": "SUSHI-Theme",
				"uiTheme": "vs-dark",
				"path": "./themes/sushi-theme.json"
			}
		],
		"configuration": {
			"title": "SUSHI-Theme",
			"properties": {
				"sushiTheme.enableStatusBar": {
					"type": "boolean",
					"default": true,
					"description": "Show StatusBar (Sushi memory indicator)"
				},
				"sushiTheme.effectType": {
					"type": "string",
					"enum": [
						"maguro",
						"ikura",
						"ebi",
						"matcha",
						"random",
						"none"
					],
					"enumItemLabels": [
						"Maguro",
						"Ikura",
						"Ebi",
						"Matcha",
						"Random",
						"None"
					],
					"default": "random",
					"description": "Select the flying sushi effect on typing. (Default: Random)"
				},
				"sushiTheme.comboUnit": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 10000,
					"description": "Keystrokes to upgrade sushi (Default: 5)"
				},
				"sushiTheme.comboTimeoutMs": {
					"type": "number",
					"default": 1500,
					"minimum": 500,
					"maximum": 100000,
					"description": "Time (in ms) before combo resets (Default: 1500)"
				},
				"sushiTheme.feverTriggerCombo": {
					"type": "number",
					"default": 50,
					"minimum": 10,
					"maximum": 10000,
					"description": "Number of combos to start Fever Time."
				},
				"sushiTheme.feverDurationMs": {
					"type": "number",
					"default": 10000,
					"minimum": 1,
					"maximum": 100000,
					"description": "How long Fever Time lasts in milliseconds (e.g., 10000 = 10 seconds)."
				},
				"sushiTheme.feverSpawnCount": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 20,
					"description": "Number of sushi dropped per keystroke in Fever Time."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run package",
		"compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
		"check-types": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"@types/vscode": "^1.116.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	}
}
