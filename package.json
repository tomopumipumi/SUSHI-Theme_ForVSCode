{
	"name": "sushitheme",
	"displayName": "SUSHI Theme",
	"description": "%sushiTheme.desc%",
	"version": "1.6.2",
	"publisher": "ichimura-tomoo",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/tomopumipumi/SUSHI-Theme_ForVSCode"
	},
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"Themes",
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"icons": {
			"sushi-maguro": {
				"description": "Maguro sushi icon",
				"default": {
					"fontPath": "./assets/fonts/sushi-icons.woff",
					"fontCharacter": "\\f000"
				}
			},
			"sushi-fire": {
				"description": "Fire icon for sushi effects",
				"default": {
					"fontPath": "./assets/fonts/sushi-icons.woff",
					"fontCharacter": "\\f001"
				}
			}
		},
		"themes": [
			{
				"label": "SUSHI-Theme",
				"uiTheme": "vs-dark",
				"path": "./themes/sushi-theme.json"
			}
		],
		"configuration": {
			"title": "SUSHI-Theme",
			"properties": {
				"sushiTheme.enableStatusBar": {
					"type": "boolean",
					"description": "%sushiTheme.enableStatusBar.desc%",
					"default": true
				},
				"sushiTheme.effectType": {
					"type": "string",
					"description": "%sushiTheme.effectType.desc%",
					"enum": [
						"maguro",
						"ikura",
						"ebi",
						"matcha",
						"random",
						"none"
					],
					"enumItemLabels": [
						"%sushiTheme.effectType.maguro%",
						"%sushiTheme.effectType.ikura%",
						"%sushiTheme.effectType.ebi%",
						"%sushiTheme.effectType.matcha%",
						"%sushiTheme.effectType.random%",
						"%sushiTheme.effectType.none%"
					],
					"default": "random"
				},
				"sushiTheme.particleSpeedMultiplier": {
					"type": "number",
					"description": "%sushiTheme.particleSpeedMultiplier.desc%",
					"default": 1.3,
					"minimum": -20,
					"maximum": 20
				},
				"sushiTheme.bounceTopDistance": {
					"type": "number",
					"description": "%sushiTheme.bounceTopDistance.desc%",
					"default": 200,
					"minimum": 0,
					"maximum": 1000
				},
				"sushiTheme.bounceBottomDistance": {
					"type": "number",
					"description": "%sushiTheme.bounceBottomDistance.desc%",
					"default": 0,
					"minimum": 0,
					"maximum": 1000
				},
				"sushiTheme.comboUnit": {
					"type": "number",
					"description": "%sushiTheme.comboUnit.desc%",
					"default": 5,
					"minimum": 1,
					"maximum": 10000
				},
				"sushiTheme.comboTimeoutMs": {
					"type": "number",
					"description": "%sushiTheme.comboTimeoutMs.desc%",
					"default": 1500,
					"minimum": 500,
					"maximum": 100000
				},
				"sushiTheme.feverTriggerCombo": {
					"type": "number",
					"description": "%sushiTheme.feverTriggerCombo.desc%",
					"default": 50,
					"minimum": 10,
					"maximum": 10000
				},
				"sushiTheme.feverDurationMs": {
					"type": "number",
					"description": "%sushiTheme.feverDurationMs.desc%",
					"default": 10000,
					"minimum": 1,
					"maximum": 100000
				},
				"sushiTheme.feverSpawnCount": {
					"type": "number",
					"description": "%sushiTheme.feverSpawnCount.desc%",
					"default": 5,
					"minimum": 1,
					"maximum": 20
				},
				"sushiTheme.throttleMs": {
					"type": "number",
					"description": "%sushiTheme.throttleMs.desc%",
					"default": 80,
					"minimum": 16,
					"maximum": 1000
				},
				"sushiTheme.fps": {
					"type": "number",
					"description": "%sushiTheme.fps.desc%",
					"enum": [
						15,
						30,
						60,
						120
					],
					"enumItemLabels": [
						"%sushiTheme.fps.enum.15%",
						"%sushiTheme.fps.enum.30%",
						"%sushiTheme.fps.enum.60%",
						"%sushiTheme.fps.enum.120%"
					],
					"default": 30
				},
				"sushiTheme.particleLifespanMultiplier": {
					"type": "number",
					"description": "%sushiTheme.particleLifespanMultiplier.desc%",
					"default": 1.0,
					"minimum": 0.1,
					"maximum": 10.0
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "pnpm run copy-locales && pnpm run package",
		"compile": "node esbuild.js",
		"watch": "pnpm copy-locales && npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "pnpm run lint && pnpm run check-types && node esbuild.js --production",
		"build:vsix": "pnpm run copy-locales && pnpm dlx @vscode/vsce package",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "pnpm run copy-locales && pnpm run compile-tests && pnpm run compile",
		"test": "vscode-test",
		"check-types": "tsc --noEmit",
		"lint": "biome check src",
		"format": "biome format --write src",
		"copy-locales": "copyfiles -u 1 \"i18n/package.nls*.json\" ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.6.0",
		"@types/vscode": "^1.116.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"copyfiles": "^2.4.1",
		"esbuild": "^0.27.3",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	}
}
