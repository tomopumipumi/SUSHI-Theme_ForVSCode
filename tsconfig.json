{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"types": ["node", "mocha"],
		"paths": {
			"@/typing-effect/*": ["./src/typing-effect/*"],
			"@/statusbar/*": ["./src/statusbar/*"],
			"@/game-settings": ["./src/game-settings"],
			"@/assets-svg/*": ["./assets/svg/*"]
		}
	}
}
